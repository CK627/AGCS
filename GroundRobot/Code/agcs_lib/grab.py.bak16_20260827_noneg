#!/usr/bin/python3
# coding=utf8
"""夹取算法（二开）：目标找回 + 高度自适应（cy 信号）+ 地面标定映射夹取 + 判定 + 重试。

流程（与官方 auto_search_grab.py 同架构）：
- 找回：摄像头切到检测位（pitch -90，21/24 固定），目标丢失则升降机身找回；
- 高度自适应：以 cy_target（标定值 240）为唯一高度信号，升降 1-20 腿（moveBody，
  +body_step/步、上限 ±body_max）把目标 cy 调到标定区间。云台锁死在检测位不动，
  只有 cy 达标后地面标定映射 pixel_to_arm_coord 才成立（支撑面≈机身标定平面）；
- 夹取：x/y 一律用地面标定映射（原本的抓取代码），z = pick_z；高度由 cy 自适应
  折算进机身姿态，不需要额外 z 补偿；
- 视觉面积距离、超声波读数不参与坐标计算（对地面物体误判过），只在日志里参考；
- 跨平面（机身已抬/降）时禁止前进逼近，防撞平台；目标在机械臂可及范围内直接夹取。
"""
import os
import time
import cv2
import numpy as np

from common.pid import PID
from agcs_lib.motion import move_body, go_forward, go_back
from agcs_lib.vision import pixel_to_arm_coord
from agcs_lib.sensors import show_status, dist_cm


class Grabber:
    """detect: callable，返回 detect_color 的 dict 或 None。"""

    def __init__(self, board, ik, ak, params, K, R, T, detect, display=None, ultrasonic=None):
        self.board = board
        self.ik = ik
        self.ak = ak
        self.params = params
        self.K, self.R, self.T = K, R, T
        self.detect = detect
        self.display = display
        self.ultrasonic = ultrasonic

        gc = params.get('grab', {})
        gf = params.get('gimbal_fetch', {})
        arm = params['arm']
        walk = params.get('walk', {})

        self.align_x_cm = float(gc.get('align_x_cm', 0.5))
        self.align_y_cm = float(gc.get('align_y_cm', 2.0))
        self.y_ref = float(gc.get('y_ref', 15.0))
        self.move_tol_px = int(gc.get('move_tol_px', 40))
        self.pos_ratio = float(gc.get('pos_ratio', 1.5))
        self.attempts = int(gc.get('attempts', 3))
        self.body_step = int(gc.get('body_lift_step', 5))
        self.body_max = int(gc.get('body_lift_max', 30))
        self.height_iter = int(gc.get('height_max_iter', 12))
        self.cy_target = int(gc.get('cy_target', 240))
        self.cy_tol = int(gc.get('cy_tol', 50))
        self.cy_sign = int(gc.get('cy_sign', 1))
        self.visible_margin = int(gc.get('visible_margin_px', 8))
        self.usable_margin = int(gc.get('usable_margin_px', 30))
        self.frame_w = int(gc.get('frame_w', 640))
        self.frame_h = int(gc.get('frame_h', 480))
        self.height_enabled = bool(gc.get('height_enabled', True))
        self.arm_tilt_step = int(gc.get('arm_tilt_step', 10))
        self.reacquire_enabled = bool(gc.get('reacquire_enabled', True))
        # 平面/高处分界：超声波实测高度超过此值才启用抬机身
        self.flat_h_cm = float(gc.get('flat_h_cm', 2.0))

        # 相机俯仰(24)限位：防止微调时低头/抬头过度丢目标
        self.cam_min = int(gc.get('cam_min', 60))
        self.cam_max = int(gc.get('cam_max', 600))

        # 超声波实测距离参数
        self.ultra_samples = int(gc.get('ultra_samples', 5))
        self.ultra_rounds = int(gc.get('ultra_rounds', 3))
        self.ultra_max_cm = float(gc.get('ultra_max_cm', 100.0))
        self.ultra_jump_cm = float(gc.get('ultra_jump_cm', 8.0))
        self.ultra_offset_cm = float(gc.get('ultra_offset_cm', 0.0))
        self.ultra_min_h_cm = float(gc.get('ultra_min_h_cm', -2.0))
        self.ultra_max_h_cm = float(gc.get('ultra_max_h_cm', 25.0))
        if isinstance(self.ultrasonic, (list, tuple)):
            self.ultra_sensors = [s for s in self.ultrasonic if s is not None]
        elif self.ultrasonic is not None:
            self.ultra_sensors = [self.ultrasonic]
        else:
            self.ultra_sensors = []
        self.ultra_dist = None

        self.pick_z = float(arm.get('pick_z', 5))
        self.gripper_open = int(arm.get('gripper_open', 120))
        self.gripper_close = int(arm.get('gripper_close', 550))
        self.reach_x = float(walk.get('reach_x', 8.0))
        self.reach_y = float(walk.get('reach_y', 24.0))
        self.body_z = 0

        # 摄像头舵机（21 水平 / 24 俯仰），用于调整后的重扫锁定
        self.x_dis = 500
        self.y_dis = 260
        self.x_pid = PID(P=0.1, I=0.001, D=0.008)
        self.y_pid = PID(P=0.1, I=0.02, D=0.008)
        self.pan_step = int(gf.get('pan_step', 40))
        self.settle = float(gf.get('settle_ms', 280)) / 1000.0
        self.v_scan = [260, 200, 320, 140, 380, 80, 440]

    def _status(self, v):
        show_status(self.display, v)

    def _detail(self, msg):
        """仅写入日志文件（SPIDERPI_LOG），不打印到终端；用于记录每个操作的详细原因。"""
        try:
            path = os.environ.get('SPIDERPI_LOG')
            if path:
                with open(path, 'a', encoding='utf-8') as f:
                    f.write('[grab][详细] %s\n' % msg)
        except Exception:
            pass

    def _stable(self, frames=60, need=5, jitter=5):
        """稳定检测，返回 detect dict 或 None。"""
        stable = 0
        old = None
        for _ in range(frames):
            r = self.detect()
            if r is None:
                stable = 0
                old = None
                time.sleep(0.05)
                continue
            c = r['center']
            if old is not None and abs(c[0] - old[0]) < jitter and abs(c[1] - old[1]) < jitter:
                stable += 1
            else:
                stable = 0
            old = c
            if stable >= need:
                return r
            time.sleep(0.05)
        return None

    def set_body(self, dz, reason=''):
        """机身升降，dz 单位 mm（正=抬高，负=降低），范围 ±body_max；reason 记录到日志文件。"""
        dz = max(-self.body_max, min(self.body_max, int(dz)))
        old_z = self.body_z
        if dz == old_z:
            return dz
        move_body(self.ik, dz)
        self.body_z = dz
        print('[grab][高度] 机身调整 %+dmm -> %+dmm' % (old_z, dz), flush=True)
        if reason:
            self._detail('机身调整 %+dmm -> %+dmm，原因：%s' % (old_z, dz, reason))
        time.sleep(0.3)
        return dz

    def _cy_ok(self, cy):
        return abs(cy - self.cy_target) <= self.cy_tol

    def _cam(self):
        self.board.bus_servo_set_position(0.02, [[24, int(self.y_dis)], [21, int(self.x_dis)]])

    def _set_cam(self, x, y):
        self.x_dis = max(0, min(1000, int(x)))
        self.y_dis = max(self.cam_min, min(self.cam_max, int(y)))
        self._cam()
        time.sleep(self.settle)

    def _track(self, center):
        cx, cy = center
        self.x_pid.SetPoint = 320
        self.x_pid.update(cx)
        self.y_pid.SetPoint = 240
        self.y_pid.update(cy)
        self._set_cam(self.x_dis + self.x_pid.output, self.y_dis + self.y_pid.output)
        return abs(cx - 320) < 30 and abs(cy - 240) < 30

    def _rescan(self):
        """21+24 双轴扫描找回目标。"""
        pans = list(range(500 + self.pan_step, 1001, self.pan_step)) + \
               list(range(1000, -1, -self.pan_step)) + \
               list(range(0, 500, self.pan_step))
        for y in self.v_scan:
            self._set_cam(500, y)
            for x in pans:
                self._set_cam(x, y)
                r = self.detect()
                if r is not None:
                    return r
        return None

    def _reacquire(self):
        """夹取阶段目标丢失时自动找回：当前检测位复检 → 机身逐级抬高（记录最佳可见）→ 逐级降低 → 复位。

        云台保持检测位不动（动 21/24 会破坏地面标定映射）。
        返回 detect dict 或 None；抬升阶段找到但中心不可用的会回落到最佳可见高度。
        """
        if not self.reacquire_enabled:
            return None
        r = self.detect()
        if r is not None:
            return r
        self._detail('稳定检测未找到目标，进入机身升降找回：抬高/降低是为了让不同平面的目标进入摄像头视野')
        # 高物体：先逐级抬高机身，记录最佳可见（面积最大）的高度
        best = None
        best_z = self.body_z
        for dz in range(self.body_step, self.body_max + 1, self.body_step):
            self.set_body(dz, reason='找回：目标不可见，抬高机身到 %dmm，让高处物体进入视野' % dz)
            print('[grab][找回] 抬高尝试 机身=%dmm' % dz, flush=True)
            r = self.detect()
            if r is not None:
                if self._usable(r):
                    print('[grab][找回] 抬高机身 %dmm，目标可用' % dz, flush=True)
                    self._detail('找回成功：机身 %dmm 时目标中心进入画面（可用），停止抬高' % dz)
                    return r
                if best is None or r.get('area', 0) > best.get('area', 0):
                    best = r
                    best_z = dz
                print('[grab][找回] 抬高机身 %dmm，目标已出现但中心不可用，继续抬高' % dz, flush=True)
                self._detail('找回中：机身 %dmm 目标已出现但中心仍在画面外（面积=%d），继续抬高'
                             % (dz, r.get('area', 0)))
        if best is not None:
            print('[grab][找回] 抬高后仍不可用，回落到最佳可见高度 %dmm（面积 %d），交给上层补抬升'
                  % (best_z, best.get('area', 0)), flush=True)
            self._detail('找回：抬高全程中心未进入画面，回落到面积最大的 %dmm（面积=%d），交给上层 _auto_lift 继续'
                         % (best_z, best.get('area', 0)))
            self.set_body(best_z, reason='找回回落：回到面积最大的可见高度 %dmm' % best_z)
            return best
        # 再逐级降低
        for dz in range(-self.body_step, -self.body_max - 1, -self.body_step):
            self.set_body(dz, reason='找回：抬高未找到，降低机身到 %dmm（目标可能在机身水平面下方）' % dz)
            print('[grab][找回] 降低尝试 机身=%dmm' % dz, flush=True)
            r = self.detect()
            if r is not None:
                print('[grab][找回] 降低机身 %dmm 找到目标' % dz, flush=True)
                self._detail('找回成功：降低到 %dmm 后目标可见' % dz)
                return r
        self.set_body(0, reason='找回失败：抬/降全程未找到目标，机身复位到 0')
        return None

    def _ultra_distance(self):
        """超声波测距：多传感器/多轮采样取最小有效值，相邻两轮一致性校验。

        返回 cm；全部无效返回 None。远距离杂波（扫到后面物体）会被 min + 校验滤掉。
        """
        if not self.ultra_sensors:
            return None

        def read_once():
            best = None
            for s in self.ultra_sensors:
                d = dist_cm(s, samples=self.ultra_samples)
                if 0 < d <= self.ultra_max_cm:
                    best = d if best is None else min(best, d)
            return best

        prev = None
        last = None
        for _ in range(max(1, self.ultra_rounds)):
            cur = read_once()
            if cur is None:
                continue
            last = cur
            if prev is not None and abs(cur - prev) <= self.ultra_jump_cm:
                return min(cur, prev)
            prev = cur
        return last

    def _coord3(self, center, dist_cm):
        """像素 + 超声波距离 → 机械臂坐标 (x, y, h)，h 为物体中心相对地面高度 cm。

        与 pixel_to_arm_coord 同一标定约定：地面时 h=0 且 x/y 与旧函数一致；
        物体抬高时（距离小于该像素的地面交点距离）h>0。
        机身抬升（body_z>0）时相机随之上移，标定相机高度 T_z 同步补偿。
        """
        u, v = center
        inv_k = np.linalg.inv(self.K)
        x_cam = inv_k.dot(np.array([[u], [v], [1.0]], dtype=np.float64))
        r_mat = np.zeros((3, 3), dtype=np.float64)
        cv2.Rodrigues(self.R, r_mat)
        rt_x = r_mat.T.dot(x_cam)
        t_eff = self.T.copy()
        t_eff[2, 0] += self.body_z  # 机身抬升量 mm
        rt_t = r_mat.T.dot(t_eff)
        s = dist_cm * 10.0 / float(np.linalg.norm(x_cam))
        w = s * rt_x - rt_t
        x = -w[0, 0] / 10.0
        y = 15.0 - w[1, 0] / 10.0  # initial_coord[1] = 15
        h = w[2, 0] / 10.0
        return x, y, h

    def _measure(self, r):
        """超声波测距 + 几何测高，返回 (d, valid, h, x, y, src)。

        只有超声波测得且高度合理的值才算有效（valid=True），用于判定高处；
        超声波无效/高度不合理一律 valid=False，按平面参考系处理，绝不使用视觉面积距离判定高度。
        """
        center = r['center']
        d = self._ultra_distance()
        if d is None:
            d = self.ultra_dist
        if d is not None:
            d = max(1.0, d + self.ultra_offset_cm)
            x, y, h = self._coord3(center, d)
            if self.ultra_min_h_cm <= h <= self.ultra_max_h_cm:
                return d, True, h, x, y, 'ultra'
            print('[grab][高度] 超声波 %.1fcm 高度不合理(%.1fcm)，按平面参考系处理' % (d, h), flush=True)
            return d, False, h, x, y, 'ultra'
        return None, False, 0.0, 0.0, 0.0, 'none'

    def _fully_visible(self, r, margin=None):
        """目标是否完整出现在画面内：轮廓外接矩形未贴边（未被裁切）。"""
        if r is None:
            return False
        contour = r.get('contour')
        if contour is None or len(contour) == 0:
            return False
        if margin is None:
            margin = self.visible_margin
        x, y, w, h = cv2.boundingRect(contour)
        return (x >= margin and y >= margin and
                x + w <= self.frame_w - margin and y + h <= self.frame_h - margin)
    def _usable(self, r):
        """目标中心在画面内（留边）且面积有效，即可用于夹取。

        近距离大目标会被画面裁切，但只要中心可见就不影响夹取，
        所以不要求外接框完整出现（放宽 search 阶段的标准）。
        """
        if r is None:
            return False
        m = int(self.usable_margin)
        cx, cy = r['center']
        return (m <= cx <= self.frame_w - m and
                m <= cy <= self.frame_h - m and
                int(r.get('area', 0)) > 0)

    def _auto_lift(self, r):
        """跨平面抬升适配：逐步抬机身，直到目标可用（中心在画面内且面积有效）。

        判定标准比 search 阶段放宽：近距离大目标天然会被画面裁切，不要求外接框
        完整出现；完整出现 / cy 居中只是优先结束条件。面积与 cy 连续不再改善时
        提前停止，避免白白抬到顶又复位。
        """
        if r is None:
            return r
        self._detail('抬升适配开始：目标中心不在画面内（被裁切太狠），抬机身直到中心可见，'
                     '为后续 cy 高度自适应做准备（当前机身=%dmm 面积=%d cy=%d）'
                     % (self.body_z, r.get('area', 0), r['center'][1]))
        best = r
        best_z = self.body_z
        best_area = int(r.get('area', 0))
        best_cy = abs(r['center'][1] - self.cy_target)
        no_gain = 0
        # 迭代上限至少覆盖到 body_max（避免 12 步×5mm=60mm 够不到 70mm 的顶）
        for _ in range(max(int(self.height_iter), self.body_max // max(1, self.body_step) + 2)):
            if self._fully_visible(r) or (self._usable(r) and self._cy_ok(r['center'][1])):
                self._detail('抬升适配停止：目标已完整出现，或中心可用且 cy 已达标')
                break
            if self.body_z >= self.body_max:
                self._detail('抬升适配停止：机身已到上限 +%dmm，不能再抬' % self.body_max)
                break
            step = min(self.body_step, self.body_max - self.body_z)
            self.set_body(self.body_z + step,
                          reason='抬升适配：目标中心未进画面，抬高 %dmm 重新检测' % step)
            rr = self.detect()
            if rr is not None:
                r = rr
                area = int(r.get('area', 0))
                cy = abs(r['center'][1] - self.cy_target)
                if (area > best_area + best_area // 20 or
                        (area >= best_area and cy < best_cy - 10)):
                    self._detail('抬升适配：机身 %dmm 处目标改善（面积=%d cy偏差=%d），记录为最优'
                                 % (self.body_z, area, cy))
                    best = r
                    best_z = self.body_z
                    best_area = area
                    best_cy = cy
                    no_gain = 0
                elif self._usable(r):
                    no_gain += 1
                    if no_gain >= 2:
                        self._detail('抬升适配停止：面积与 cy 连续 2 步无改善（当前面积=%d），避免白抬' % area)
                        break
        if not self._usable(r) and self.body_z != best_z:
            print('[grab][高度] 目标仍不可用，回到最优高度 %dmm（面积 %d）' % (best_z, best_area), flush=True)
            self._detail('抬升适配：结束后目标仍不可用，回到最优高度 %dmm（面积=%d）' % (best_z, best_area))
            self.set_body(best_z, reason='抬升适配回落：回到面积最大的高度 %dmm' % best_z)
            r = best
        print('[grab][高度] 持续抬升结束：机身=%dmm 完整出现=%s 可用=%s 面积=%d'
              % (self.body_z, self._fully_visible(r), self._usable(r), r.get('area', 0)), flush=True)
        self._detail('抬升适配结束：机身=%dmm 可用=%s 面积=%d，交给 cy 高度自适应定最终高度'
                     % (self.body_z, self._usable(r), r.get('area', 0)))
        return r

    def _solve(self, center, d):
        """距离 + 像素 → (x, y, h)；高度不合理时退回地面平面映射。"""
        if d is None:
            x, y = self._coord(center)
            return x, y, 0.0
        x, y, h = self._coord3(center, d)
        if h < self.ultra_min_h_cm or h > self.ultra_max_h_cm:
            print('[grab][高度] 实测高度 %.1fcm 不合理，退回地面平面' % h, flush=True)
            x, y = self._coord(center)
            return x, y, 0.0
        return x, y, h

    def adjust_height(self, cy):
        """高度自适应（官方架构核心）：升降机身把目标 cy 调到标定值 cy_target。

        只动 1-20 腿（moveBody），云台/相机锁死在检测位——动 21/24 会让地面标定
        映射失效。返回 (ok, limited)；limited=True 表示已到 ±body_max 限位仍未达标。
        """
        print('[grab][高度] 开始调整 cy=%d target=%d 机身=%+dmm' % (cy, self.cy_target, self.body_z))
        self._detail('高度自适应开始：cy=%d，标定值 cy_target=%d，机身=%+dmm。'
                     '原因：只有把 cy 调到标定区间，地面标定映射 pixel_to_arm_coord 才成立，'
                     '否则夹取坐标会偏到平台上' % (cy, self.cy_target, self.body_z))
        cur = cy
        for i in range(max(int(self.height_iter), self.body_max // max(1, self.body_step) + 2)):
            if self._cy_ok(cur):
                self._detail('高度自适应完成：cy=%d 已进入 %d±%d 标定区间' % (cur, self.cy_target, self.cy_tol))
                return True, False
            step = max(self.body_step, min(self.body_max, abs(cur - self.cy_target) // 10))
            step *= self.cy_sign
            if cur < self.cy_target:
                if self.body_z + step <= self.body_max:
                    self.set_body(self.body_z + step,
                                  reason='高度自适应：cy=%d<target=%d（目标偏高/偏远），抬高机身 %dmm'
                                         % (cur, self.cy_target, step))
                else:
                    print('[grab][高度] 机身已达上限，无法继续抬高', flush=True)
                    self._detail('高度自适应失败：机身已达上限 +%dmm，cy=%d 仍 < %d（目标太高/太远，抬高不够）'
                                 % (self.body_max, cur, self.cy_target))
                    return False, True
            else:
                if self.body_z - step >= -self.body_max:
                    self.set_body(self.body_z - step,
                                  reason='高度自适应：cy=%d>target=%d（目标偏近/偏低），降低机身 %dmm'
                                         % (cur, self.cy_target, step))
                else:
                    print('[grab][高度] 机身已达下限，无法继续降低', flush=True)
                    self._detail('高度自适应失败：机身已达下限 -%dmm，cy=%d 仍 > %d（目标太近/太低，降低不够）'
                                 % (self.body_max, cur, self.cy_target))
                    return False, True
            r = self.detect()
            if r is None:
                print('[grab][高度] 调整中目标丢失，尝试找回', flush=True)
                self._detail('高度自适应：升降后目标丢失，触发机身找回（保持云台检测位）')
                r = self._reacquire()
            if r is None:
                return False, True
            cur = r['center'][1]
            time.sleep(0.25)
        self._detail('高度自适应：迭代次数用尽仍未达标（cy=%d），按当前姿态继续' % cur)
        return False, True

    def _coord(self, center):
        return pixel_to_arm_coord(self.K, self.R, self.T, center, initial_coord=(0, 15, 5))

    def _aligned(self, x, y):
        return abs(x) <= self.align_x_cm and abs(y - self.y_ref) <= self.align_y_cm

    def _grab_once(self, x, y, z=None):
        if z is None:
            z = self.pick_z
        res = self.ak.setPitchRangeMoving((x, y + 2.0, z), -90, -90, 100, 1)
        if res is False:
            return False
        time.sleep(1.5)
        self.board.bus_servo_set_position(0.5, [[25, self.gripper_close]])
        time.sleep(1.5)
        self.ak.setPitchRangeMoving((12, 24, 5), -90, -90, 100, 1.5)
        time.sleep(1.5)
        self.ak.setPitchRangeMoving((12, 24, -5), -90, -90, 100, 1)
        time.sleep(1)
        self.board.bus_servo_set_position(0.5, [[25, self.gripper_open]])
        time.sleep(0.5)
        self.ak.setPitchRangeMoving((12, 24, 5), -90, -90, 100, 1)
        time.sleep(1)
        self.ak.setPitchRangeMoving((0, 15, 5), -90, -90, 100, 1.5)
        time.sleep(1.5)
        return True

    def _verify(self, before):
        for _ in range(5):
            r = self.detect()
            if r is None:
                return True
            c = r['center']
            radius = max(int(r.get('radius', 20)), 1)
            tol = max(self.move_tol_px, int(self.pos_ratio * radius))
            if abs(c[0] - before[0]) > tol or abs(c[1] - before[1]) > tol:
                return True
            time.sleep(0.1)
        return False

    def run(self, cy=None, x_dis=None, y_dis=None):
        self.board.bus_servo_set_position(0.5, [[25, self.gripper_open]])
        if x_dis is not None:
            self.x_dis = x_dis
        if y_dis is not None:
            self.y_dis = y_dis
        self.found_x = self.x_dis
        self.found_y = self.y_dis

        self.ultra_dist = self._ultra_distance()
        if self.ultra_dist is not None:
            print('[grab][高度] 超声波距离 %.1fcm，使用实测高度补偿' % self.ultra_dist, flush=True)

        # 切回检测位（相机朝下 pitch -90），保证 pixel_to_arm_coord 的标定姿态一致
        self.ak.setPitchRangeMoving((0, 15, 5), -90, -90, 100, 2)
        time.sleep(2)
        self._detail('进入抓取阶段：相机切回检测位 pitch=-90、云台 21/24 固定，'
                     '保证地面标定映射的标定姿态一致（当前机身=%+dmm）' % self.body_z)

        for attempt in range(self.attempts):
            print('[grab] 第 %d/%d 次' % (attempt + 1, self.attempts))
            self._status(2)
            self._detail('第 %d/%d 次尝试开始（重试原因：上次未夹到/目标丢失/超出可及）'
                         % (attempt + 1, self.attempts))
            r = self._stable()
            if r is None:
                r = self._reacquire()
                if r is None:
                    print('[grab] 机身调整后仍未找到目标 (最后机身 %dmm)' % self.body_z, flush=True)
                    continue

            # 找回后先保证目标中心在画面内（被裁切太狠才抬机身）
            if self.height_enabled and not self._usable(r):
                self._detail('触发抬升适配：目标中心不在画面内（center=%s，usable_margin=%dpx）'
                             % (r['center'], self.usable_margin))
                r = self._auto_lift(r)
                if r is None:
                    print('[grab] 抬升适配后目标丢失', flush=True)
                    self._detail('抬升适配后目标丢失，本次尝试放弃')
                    continue

            # 高度自适应（官方架构核心）：把 cy 调到标定值 cy_target，
            # 这样下面的地面标定映射（原本的抓取代码）在抬/降后的机身上依然成立
            if self.height_enabled and not self._cy_ok(r['center'][1]):
                self._detail('触发高度自适应：cy=%d 不在 %d±%d 标定区间'
                             % (r['center'][1], self.cy_target, self.cy_tol))
                ok, limited = self.adjust_height(r['center'][1])
                rr = self.detect()
                if rr is None:
                    rr = self._reacquire()
                if rr is not None:
                    r = rr
                if r is None:
                    print('[grab] 高度调整后目标丢失', flush=True)
                    continue
                # 到限位 cy 仍偏大（目标太近/太低）：安全后退一步再试，最多 2 次
                retry = 0
                while (not ok and limited and r['center'][1] > self.cy_target
                       and retry < 2):
                    print('[grab][高度] cy=%d 仍大于目标且机身到限位，后退 12mm 重试' % r['center'][1], flush=True)
                    self._detail('限位后重试：cy=%d 仍 > %d 且机身到限位，说明目标太近/太低，'
                                 '后退 12mm 让几何回到标定范围（第 %d 次）'
                                 % (r['center'][1], self.cy_target, retry + 1))
                    go_back(self.ik, 12, 50)
                    time.sleep(0.4)
                    rr = self.detect()
                    if rr is None:
                        rr = self._reacquire()
                    if rr is None:
                        break
                    r = rr
                    ok, limited = self.adjust_height(r['center'][1])
                    retry += 1
                if not ok:
                    print('[grab][高度] 调整未完全达标（限位=%s），按当前姿态尝试夹取' % limited, flush=True)

            center = r['center']

            # 统一用原本的地面标定映射 + pick_z（与官方 auto_search_grab 一致：
            # cy 自适应已把高度折算进机身姿态，无需再做 z 补偿）
            x, y = self._coord(center)
            z_grab = self.pick_z
            print('[grab] 像素=%s -> x=%.1f cm y=%.1f cm（机身=%+dmm cy=%d z=%.1f）'
                  % (center, x, y, self.body_z, center[1], z_grab))
            self._detail('坐标计算：cy 已达标（或尽最大调整），用地面标定映射 pixel_to_arm_coord'
                         '计算 x/y=%.1f/%.1f，z=pick_z=%.1f（官方抓取代码，高度已折算进机身）'
                         % (x, y, z_grab))

            unreachable = False
            for _ in range(20):
                if self._aligned(x, y):
                    break
                rr = self.detect()
                if rr is None:
                    break
                x, y = self._coord(rr['center'])
                if self.body_z != 0:
                    # 跨平面（机身已抬/降）：只允许后退，禁止前进（防撞平台）；
                    # 目标在可及范围内直接夹取，不强求 y_ref
                    if y > self.reach_y or abs(x) > self.reach_x or y < 0:
                        print('[grab] 跨平面模式，目标 x=%.1f y=%.1f 超出可及范围，中止本次' % (x, y), flush=True)
                        self._detail('跨平面对准中止：机身=%+dmm 时目标 x=%.1f y=%.1f 超出可及范围'
                                     '（reach_x=%.0f reach_y=%.0f），且禁止前进防撞平台，本次放弃'
                                     % (self.body_z, x, y, self.reach_x, self.reach_y))
                        unreachable = True
                        break
                    if y < self.y_ref - self.align_y_cm:
                        self._detail('跨平面对准：y=%.1f < y_ref-%.0f（目标偏近），安全后退 12mm'
                                     % (y, self.align_y_cm))
                        go_back(self.ik, 12, 50)
                    else:
                        self._detail('跨平面对准：机身已抬/降，禁止前进防撞平台；目标 y=%.1f '
                                     '在可及范围内，直接夹取（不强求 y_ref=%.0f）' % (y, self.y_ref))
                        break
                else:
                    if y > self.y_ref + self.align_y_cm:
                        self._detail('平面模式对准：y=%.1f > y_ref+%.0f（目标偏远），前进 12mm 靠近'
                                     % (y, self.align_y_cm))
                        go_forward(self.ik, 12, 50)
                    elif y < self.y_ref - self.align_y_cm:
                        self._detail('平面模式对准：y=%.1f < y_ref-%.0f（目标偏近），后退 12mm'
                                     % (y, self.align_y_cm))
                        go_back(self.ik, 12, 50)
                time.sleep(0.4)
            if unreachable:
                continue

            # 对准后重测，刷新最终抓取坐标（同样用地面标定映射 + pick_z）
            rf = self.detect()
            if rf is not None:
                x, y = self._coord(rf['center'])
                z_grab = self.pick_z

            if abs(x) > self.reach_x or y > self.reach_y or y < 0:
                print('[grab] 超出可及范围 x=%.1f cm y=%.1f cm，中止本次' % (x, y))
                self._detail('可及范围检查失败：x=%.1f y=%.1f（reach_x=%.0f reach_y=%.0f），'
                             '机械臂够不到，中止本次' % (x, y, self.reach_x, self.reach_y))
                continue

            self._detail('伸出机械臂：setPitchRangeMoving 到 (%.1f, %.1f, %.1f) 夹取'
                         % (x, y + 2.0, z_grab))
            if not self._grab_once(x, y, z_grab):
                print('[grab] 逆运动学无解，中止本次')
                self._detail('逆运动学无解：目标点 (%.1f, %.1f, %.1f) 超出机械臂解算范围，中止本次'
                             % (x, y, z_grab))
                continue

            if self._verify(center):
                self._status(3)
                print('[grab] 夹取成功')
                self._detail('夹取验证通过：夹取后目标消失/明显位移，判定已夹到')
                return True
            print('[grab] 目标未移动，未夹到，回到靠近位置')
            self._detail('夹取验证失败：目标仍在原位（未夹到），机身复位并回到检测位准备重试')
            self.set_body(0, reason='夹取失败重试：机身复位到 0 并回检测位')
            self.ak.setPitchRangeMoving((0, 15, 5), -90, -90, 100, 2)
            time.sleep(1.5)

        return False
