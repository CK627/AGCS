#!/usr/bin/python3
# coding=utf8
"""bgas = Before-Grab-After-Search：搜索与抓取之间的"可抓取判定 + 定位"阶段。

只动 1-20（腿/机身）和一次性云台/臂切位；保证 grab 阶段不再需要调整 1-20。
双路线（按目标能否在 -90 检测位看到自动选择）：
A. 映射路线（目标在 -90 检测位可见，通常是地面/低处）：
   cy 高度自适应（升降机身调到 cy_target±cy_tol）→ 地面标定映射算 (x,y) → 可及检查。
   出口：context{strategy:'mapped', x, y, z}，grab 用标定映射夹取。
B. 倾斜闭环路线（-90 看不到，通常是高处平台；官方 grab_blocks.py 同款）：
   相机切到倾斜位（tilt_pose + tilt_pitch），cx/cy 窗口闭环：
   偏左/右转身，偏上（远/高）先抬身再前进，偏下（近/低）先降身再后退，
   连续稳定在窗口内 → 出口：context{strategy:'fixed', x, y, z}，grab 伸到固定点夹取。
"""
import os
import time

from agcs_lib.motion import move_body, go_forward, go_back, turn_left, turn_right
from agcs_lib.vision import pixel_to_arm_coord
from agcs_lib.sensors import show_status


class Bgas:
    """定位阶段：判定/调整到"可抓取"状态，只动 1-20。"""

    def __init__(self, board, ik, ak, params, K, R, T, detect, display=None, ultrasonic=None):
        self.board = board
        self.ik = ik
        self.ak = ak
        self.params = params
        self.K, self.R, self.T = K, R, T
        self.detect = detect
        self.display = display
        self.ultrasonic = ultrasonic  # 仅兼容旧调用，本阶段不依赖超声波

        gc = params.get('grab', {})
        walk = params.get('walk', {})
        gf = params.get('gimbal_fetch', {})
        arm = params['arm']

        self.body_step = int(gc.get('body_lift_step', 5))
        self.body_max = int(gc.get('body_lift_max', 70))
        self.body_min = int(gc.get('body_lift_min', 0))
        self.height_iter = int(gc.get('height_max_iter', 12))
        self.cy_target = int(gc.get('cy_target', 240))
        self.cy_tol = int(gc.get('cy_tol', 50))
        self.cy_sign = int(gc.get('cy_sign', 1))
        self.usable_margin = int(gc.get('usable_margin_px', 30))
        self.frame_w = int(gc.get('frame_w', 640))
        self.frame_h = int(gc.get('frame_h', 480))
        self.reacquire_enabled = bool(gc.get('reacquire_enabled', True))
        self.height_enabled = bool(gc.get('height_enabled', True))

        self.reach_x = float(walk.get('reach_x', 8.0))
        self.reach_y = float(walk.get('reach_y', 24.0))
        self.y_ref = float(gc.get('y_ref', 15.0))
        self.align_y_cm = float(gc.get('align_y_cm', 2.0))
        self.pick_z = float(arm.get('pick_z', -5))
        self.turn_sign = int(gf.get('turn_sign', 1))

        # 定位循环参数
        self.adapt_rounds = int(gc.get('adapt_rounds', 4))
        self.walk_mm = int(gc.get('approach_walk_mm', 12))
        self.max_forward = int(gc.get('approach_max_forward', 6))
        self.max_back = int(gc.get('approach_max_back', 6))

        # 倾斜闭环参数（官方 grab_blocks.py 同款默认值）
        self.tilt_pose = [float(v) for v in gc.get('tilt_pose', [0, 15, 18])]
        self.tilt_pitch = int(gc.get('tilt_pitch', -35))
        self.tilt_cy_min = int(gc.get('tilt_cy_min', 330))
        self.tilt_cy_max = int(gc.get('tilt_cy_max', 430))
        self.tilt_cx_min = int(gc.get('tilt_cx_min', 250))
        self.tilt_cx_max = int(gc.get('tilt_cx_max', 390))
        self.tilt_turn_deg = int(gc.get('tilt_turn_deg', 4))
        self.tilt_rounds = int(gc.get('tilt_rounds', 12))
        self.fixed_grab = [float(v) for v in gc.get('fixed_grab', [0, 20])]
        self.fixed_z = float(gc.get('fixed_grab_z', 5))

        self.body_z = 0

    # ---------- 工具 ----------
    def _status(self, v):
        show_status(self.display, v)

    def _detail(self, msg):
        """仅写入日志文件（SPIDERPI_LOG），不打印到终端；用于记录每个操作的详细原因。"""
        try:
            path = os.environ.get('SPIDERPI_LOG')
            if path:
                with open(path, 'a', encoding='utf-8') as f:
                    f.write('[bgas][详细] %s\n' % msg)
        except Exception:
            pass

    def _stable(self, frames=60, need=5, jitter=5):
        """稳定检测，返回 detect dict 或 None。"""
        stable = 0
        old = None
        for _ in range(frames):
            r = self.detect()
            if r is None:
                stable = 0
                old = None
                time.sleep(0.05)
                continue
            c = r['center']
            if old is not None and abs(c[0] - old[0]) < jitter and abs(c[1] - old[1]) < jitter:
                stable += 1
            else:
                stable = 0
            old = c
            if stable >= need:
                return r
            time.sleep(0.05)
        return None

    def _usable(self, r):
        """目标中心在画面内（留边）且面积有效，即可用于定位/夹取。

        近距离大目标会被画面裁切，但只要中心可见就不影响，不要求外接框完整出现。
        """
        if r is None:
            return False
        m = int(self.usable_margin)
        cx, cy = r['center']
        return (m <= cx <= self.frame_w - m and
                m <= cy <= self.frame_h - m and
                int(r.get('area', 0)) > 0)

    def _cy_ok(self, cy):
        return abs(cy - self.cy_target) <= self.cy_tol

    def _coord(self, center):
        return pixel_to_arm_coord(self.K, self.R, self.T, center, initial_coord=(0, 15, 5))

    def _turn_body(self, deg):
        """转身 deg 度（正=左转），带 turn_sign 方向修正。"""
        if deg == 0:
            return
        if self.turn_sign > 0:
            (turn_left if deg > 0 else turn_right)(self.ik, abs(deg), 60)
        else:
            (turn_right if deg > 0 else turn_left)(self.ik, abs(deg), 60)

    def set_body(self, dz, reason=''):
        """机身升降，dz 单位 mm（正=抬高，负=降低），范围 body_min~body_max（默认 0~70，不用负姿态）。"""
        dz = max(self.body_min, min(self.body_max, int(dz)))
        old_z = self.body_z
        if dz == old_z:
            return dz
        move_body(self.ik, dz)
        self.body_z = dz
        print('[bgas][高度] 机身调整 %+dmm -> %+dmm' % (old_z, dz), flush=True)
        if reason:
            self._detail('机身调整 %+dmm -> %+dmm，原因：%s' % (old_z, dz, reason))
        time.sleep(0.3)
        return dz

    # ---------- 找回 ----------
    def _reacquire(self):
        """目标不可见时找回：当前检测位复检 → 机身逐级抬高（只抬不降）→ 复位。

        云台保持检测位不动（动 21/24 会破坏地面标定映射）。
        返回 detect dict 或 None；抬升阶段找到但中心不可用的会回落到最佳可见高度。
        """
        if not self.reacquire_enabled:
            return None
        r = self.detect()
        if r is not None:
            return r
        self._detail('稳定检测未找到目标，进入机身升降找回：只抬不降（body_min=0，不用负姿态），'
                     '抬高是为了让高处物体进入摄像头视野')
        best = None
        best_z = self.body_z
        for dz in range(self.body_step, self.body_max + 1, self.body_step):
            self.set_body(dz, reason='找回：目标不可见，抬高机身到 %dmm，让高处物体进入视野' % dz)
            print('[bgas][找回] 抬高尝试 机身=%dmm' % dz, flush=True)
            r = self.detect()
            if r is not None:
                if self._usable(r):
                    print('[bgas][找回] 抬高机身 %dmm，目标可用' % dz, flush=True)
                    self._detail('找回成功：机身 %dmm 时目标中心进入画面（可用），停止抬高' % dz)
                    return r
                if best is None or r.get('area', 0) > best.get('area', 0):
                    best = r
                    best_z = dz
                print('[bgas][找回] 抬高机身 %dmm，目标已出现但中心不可用，继续抬高' % dz, flush=True)
                self._detail('找回中：机身 %dmm 目标已出现但中心仍在画面外（面积=%d），继续抬高'
                             % (dz, r.get('area', 0)))
        if best is not None:
            print('[bgas][找回] 抬高后仍不可用，回落到最佳可见高度 %dmm（面积 %d），交给上层补抬升'
                  % (best_z, best.get('area', 0)), flush=True)
            self._detail('找回：抬高全程中心未进入画面，回落到面积最大的 %dmm（面积=%d），交给上层 _auto_lift 继续'
                         % (best_z, best.get('area', 0)))
            self.set_body(best_z, reason='找回回落：回到面积最大的可见高度 %dmm' % best_z)
            return best
        self.set_body(0, reason='找回失败：抬升全程未找到目标，机身复位到 0')
        return None

    # ---------- 抬升适配（目标中心被裁切时） ----------
    def _auto_lift(self, r):
        """逐步抬机身，直到目标可用（中心在画面内且面积有效）。

        完整出现 / cy 居中只是优先结束条件；面积与 cy 连续不再改善时提前停止。
        """
        if r is None:
            return r
        self._detail('抬升适配开始：目标中心不在画面内（被裁切太狠），抬机身直到中心可见，'
                     '为后续 cy 高度自适应做准备（当前机身=%dmm 面积=%d cy=%d）'
                     % (self.body_z, r.get('area', 0), r['center'][1]))
        best = r
        best_z = self.body_z
        best_area = int(r.get('area', 0))
        best_cy = abs(r['center'][1] - self.cy_target)
        no_gain = 0
        for _ in range(max(int(self.height_iter), self.body_max // max(1, self.body_step) + 2)):
            if (self._usable(r) and self._cy_ok(r['center'][1])):
                self._detail('抬升适配停止：目标中心可用且 cy 已达标')
                break
            if self.body_z >= self.body_max:
                self._detail('抬升适配停止：机身已到上限 +%dmm，不能再抬' % self.body_max)
                break
            step = min(self.body_step, self.body_max - self.body_z)
            self.set_body(self.body_z + step,
                          reason='抬升适配：目标中心未进画面，抬高 %dmm 重新检测' % step)
            rr = self.detect()
            if rr is not None:
                r = rr
                area = int(r.get('area', 0))
                cy = abs(r['center'][1] - self.cy_target)
                if (area > best_area + best_area // 20 or
                        (area >= best_area and cy < best_cy - 10)):
                    self._detail('抬升适配：机身 %dmm 处目标改善（面积=%d cy偏差=%d），记录为最优'
                                 % (self.body_z, area, cy))
                    best = r
                    best_z = self.body_z
                    best_area = area
                    best_cy = cy
                    no_gain = 0
                elif self._usable(r):
                    no_gain += 1
                    if no_gain >= 2:
                        self._detail('抬升适配停止：面积与 cy 连续 2 步无改善（当前面积=%d），避免白抬' % area)
                        break
        if not self._usable(r) and self.body_z != best_z:
            print('[bgas][高度] 目标仍不可用，回到最优高度 %dmm（面积 %d）' % (best_z, best_area), flush=True)
            self._detail('抬升适配：结束后目标仍不可用，回到最优高度 %dmm（面积=%d）' % (best_z, best_area))
            self.set_body(best_z, reason='抬升适配回落：回到面积最大的高度 %dmm' % best_z)
            r = best
        print('[bgas][高度] 抬升适配结束：机身=%dmm 可用=%s 面积=%d'
              % (self.body_z, self._usable(r), r.get('area', 0)), flush=True)
        self._detail('抬升适配结束：机身=%dmm 可用=%s 面积=%d，交给 cy 高度自适应定最终高度'
                     % (self.body_z, self._usable(r), r.get('area', 0)))
        return r

    # ---------- 高度自适应（cy 信号，映射路线用） ----------
    def adjust_height(self, cy):
        """升降机身把目标 cy 调到标定值 cy_target。只动 1-20，云台锁死检测位。"""
        print('[bgas][高度] 开始调整 cy=%d target=%d 机身=%+dmm' % (cy, self.cy_target, self.body_z))
        self._detail('高度自适应开始：cy=%d，标定值 cy_target=%d，机身=%+dmm。'
                     '原因：只有把 cy 调到标定区间，地面标定映射 pixel_to_arm_coord 才成立'
                     % (cy, self.cy_target, self.body_z))
        cur = cy
        for i in range(max(int(self.height_iter), self.body_max // max(1, self.body_step) + 2)):
            if self._cy_ok(cur):
                self._detail('高度自适应完成：cy=%d 已进入 %d±%d 标定区间' % (cur, self.cy_target, self.cy_tol))
                return True, False
            step = max(self.body_step, min(self.body_max, abs(cur - self.cy_target) // 10))
            step *= self.cy_sign
            if cur < self.cy_target:
                if self.body_z + step <= self.body_max:
                    self.set_body(self.body_z + step,
                                  reason='高度自适应：cy=%d<target=%d（目标偏高/偏远），抬高机身 %dmm'
                                         % (cur, self.cy_target, step))
                else:
                    print('[bgas][高度] 机身已达上限，无法继续抬高', flush=True)
                    self._detail('高度自适应失败：机身已达上限 +%dmm，cy=%d 仍 < %d（目标太高/太远，抬高不够）'
                                 % (self.body_max, cur, self.cy_target))
                    return False, True
            else:
                if self.body_z - step >= self.body_min:
                    self.set_body(self.body_z - step,
                                  reason='高度自适应：cy=%d>target=%d（目标偏近/偏低），降低机身 %dmm'
                                         % (cur, self.cy_target, step))
                else:
                    print('[bgas][高度] 机身已达下限 %dmm，无法继续降低' % self.body_min, flush=True)
                    self._detail('高度自适应失败：机身已达下限 %dmm，cy=%d 仍 > %d（目标太近/太低，'
                                 '降低不够；将由上层后退重试）' % (self.body_min, cur, self.cy_target))
                    return False, True
            r = self.detect()
            if r is None:
                print('[bgas][高度] 调整中目标丢失，尝试找回', flush=True)
                self._detail('高度自适应：升降后目标丢失，触发机身找回（保持云台检测位）')
                r = self._reacquire()
            if r is None:
                return False, True
            cur = r['center'][1]
            time.sleep(0.25)
        self._detail('高度自适应：迭代次数用尽仍未达标（cy=%d），按当前姿态继续' % cur)
        return False, True

    # ---------- 主流程 ----------
    def run(self, cy=None, x_dis=None, y_dis=None):
        """定位到"可抓取"状态；返回 (context, reason)。失败时 context=None。"""
        # 阶段一：切 -90 检测位探测（低处/地面 → 映射路线）
        self.ak.setPitchRangeMoving((0, 15, 5), -90, -90, 100, 2)
        time.sleep(2)
        self._detail('bgas 阶段一：切 -90 检测位探测（搜索移交 x_dis=%s y_dis=%s cy=%s）' % (x_dis, y_dis, cy))
        self._status(1)
        probe = None
        for _ in range(5):
            r = self.detect()
            if r is not None and self._usable(r):
                probe = r
                break
            time.sleep(0.1)
        if probe is not None:
            pcy = probe['center'][1]
            if abs(pcy - self.cy_target) > 120:
                # -90 可见但 cy 远离标定值（过近/过远）：映射路线必然调不到，直接倾斜闭环
                self._detail('bgas 阶段一：目标在 -90 检测位可见但 cy=%d 远离标定值 %d（过近/过远），'
                             '直接转倾斜闭环路线' % (pcy, self.cy_target))
                return self._run_tilted()
            self._detail('bgas 阶段一：目标在 -90 检测位可见，走映射路线（地面/低处）')
            ctx, reason = self._run_mapped(probe)
            if ctx is not None:
                return ctx, None
            # 映射路线调不动（太近/太远/超可及等）→ 回退到倾斜闭环（固定点已实测够得到）
            self._detail('bgas 映射路线失败（%s），回退到倾斜闭环路线' % reason)
            print('[bgas] 映射路线失败（%s），转倾斜闭环' % reason, flush=True)
            return self._run_tilted()
        self._detail('bgas 阶段一：目标在 -90 检测位不可见（判断为高处平台），转倾斜闭环路线')
        return self._run_tilted()

    def _run_mapped(self, probe):
        """映射路线：cy 高度自适应 + 地面标定映射可及检查。"""
        walk_f = 0
        walk_b = 0
        last_reason = '未知'
        r = probe
        for round_no in range(self.adapt_rounds):
            print('[bgas][映射] 定位第 %d/%d 轮' % (round_no + 1, self.adapt_rounds))
            if r is None or not self._usable(r):
                r = self._stable()
            if r is None:
                r = self._reacquire()
                if r is None:
                    last_reason = '目标不可见：抬身找回失败'
                    print('[bgas] 失败：%s' % last_reason, flush=True)
                    return None, last_reason
            if not self._usable(r):
                r = self._auto_lift(r)
                if r is None:
                    last_reason = '目标中心不可用'
                    print('[bgas] 失败：%s' % last_reason, flush=True)
                    return None, last_reason

            if self.height_enabled and not self._cy_ok(r['center'][1]):
                ok, limited = self.adjust_height(r['center'][1])
                rr = self.detect()
                if rr is None:
                    rr = self._reacquire()
                if rr is not None:
                    r = rr
                if r is None:
                    last_reason = '高度调整中目标丢失'
                    return None, last_reason
                if not ok:
                    if limited and r['center'][1] > self.cy_target and walk_b < self.max_back:
                        print('[bgas] cy=%d 仍 > 目标且机身到下限，后退 %dmm' % (r['center'][1], self.walk_mm), flush=True)
                        self._detail('bgas 后退：cy=%d>%d 且机身已到下限（目标太近），后退 %dmm'
                                     % (r['center'][1], self.cy_target, self.walk_mm))
                        go_back(self.ik, self.walk_mm, 50)
                        walk_b += 1
                        time.sleep(0.4)
                        continue
                    if limited:
                        last_reason = 'cy 无法调到标定区间（机身到限位）'
                        print('[bgas] 失败：%s（cy=%d 机身=%+dmm）' % (last_reason, r['center'][1], self.body_z), flush=True)
                        return None, last_reason

            x, y = self._coord(r['center'])
            self._detail('bgas 校验：像素=%s -> x=%.1f y=%.1f（机身=%+dmm cy=%d）'
                         % (r['center'], x, y, self.body_z, r['center'][1]))
            if y > self.reach_y or abs(x) > self.reach_x or y < 0:
                if self.body_z == 0 and walk_f < self.max_forward:
                    print('[bgas] 目标 x=%.1f y=%.1f 超出可及且机身未抬（平地），前进 %dmm'
                          % (x, y, self.walk_mm), flush=True)
                    self._detail('bgas 前进：y=%.1f>reach_y=%.0f（目标偏远）且机身未抬（平地安全），前进 %dmm'
                                 % (y, self.reach_y, self.walk_mm))
                    go_forward(self.ik, self.walk_mm, 50)
                    walk_f += 1
                    time.sleep(0.4)
                    continue
                last_reason = '目标超出可及范围（%s）' % ('跨平面禁止前进' if self.body_z != 0 else '已前进到上限')
                print('[bgas] 失败：%s（x=%.1f y=%.1f 机身=%+dmm）' % (last_reason, x, y, self.body_z), flush=True)
                return None, last_reason
            if y < self.y_ref - self.align_y_cm and walk_b < self.max_back:
                print('[bgas] 目标 y=%.1f 偏近，后退 %dmm' % (y, self.walk_mm), flush=True)
                self._detail('bgas 后退：y=%.1f < y_ref-%.0f（目标太近），后退 %dmm'
                             % (y, self.align_y_cm, self.walk_mm))
                go_back(self.ik, self.walk_mm, 50)
                walk_b += 1
                time.sleep(0.4)
                continue

            print('[bgas][映射] 定位完成：x=%.1f y=%.1f cy=%d 机身=%+dmm' % (x, y, r['center'][1], self.body_z))
            context = {
                'strategy': 'mapped',
                'detect': r,
                'x': float(x),
                'y': float(y),
                'z': float(self.pick_z),
                'body_z': int(self.body_z),
                'cy': int(r['center'][1]),
            }
            self._detail('bgas 映射路线验收通过：可见 + cy=%d∈%d±%d + x/y=%.1f/%.1f 在可及范围 + 云台检测位；'
                         '移交 grab（grab 只动 21-25）' % (context['cy'], self.cy_target, self.cy_tol, x, y))
            self._status(2)
            return context, None
        return None, '映射路线定位 %d 轮仍未达标（最后原因：%s）' % (self.adapt_rounds, last_reason)

    def _run_tilted(self):
        """倾斜闭环路线（官方 grab_blocks.py 同款）：cx/cy 窗口闭环，出口为固定夹取点。"""
        self.ak.setPitchRangeMoving(tuple(self.tilt_pose), self.tilt_pitch, -90, 100, 2)
        time.sleep(2)
        self._detail('bgas 阶段二：切倾斜位 pose=%s pitch=%d，cx/cy 窗口闭环定位（只动 1-20）'
                     % (self.tilt_pose, self.tilt_pitch))
        walk_f = 0
        walk_b = 0
        stable = 0
        for round_no in range(self.tilt_rounds):
            r = self._stable(frames=30, need=3)
            if r is None:
                stable = 0
                r = self._reacquire()
                if r is None:
                    print('[bgas][倾斜] 第 %d 轮目标不可见，小角度转身重找' % (round_no + 1), flush=True)
                    self._detail('倾斜闭环：目标不可见且抬身找回失败，左转 %d° 重找'
                                 % self.tilt_turn_deg)
                    self._turn_body(self.tilt_turn_deg)
                    time.sleep(0.6)
                    continue
            cx, cy = r['center']
            print('[bgas][倾斜] 第 %d/%d 轮 cx=%d cy=%d 机身=%+dmm'
                  % (round_no + 1, self.tilt_rounds, cx, cy, self.body_z))
            moved = False
            if cx < self.tilt_cx_min:
                self._detail('倾斜闭环：cx=%d < %d（目标偏左），左转 %d°'
                             % (cx, self.tilt_cx_min, self.tilt_turn_deg))
                self._turn_body(self.tilt_turn_deg)
                moved = True
            elif cx > self.tilt_cx_max:
                self._detail('倾斜闭环：cx=%d > %d（目标偏右），右转 %d°'
                             % (cx, self.tilt_cx_max, self.tilt_turn_deg))
                self._turn_body(-self.tilt_turn_deg)
                moved = True
            elif cy < self.tilt_cy_min:
                # 偏上（远/高）：先抬身（应对平台高），抬到头再前进
                if self.body_z < self.body_max:
                    step = min(self.body_step, self.body_max - self.body_z)
                    self.set_body(self.body_z + step,
                                  reason='倾斜闭环：cy=%d < 窗口下限 %d（目标偏高/远），抬高机身 %dmm'
                                         % (cy, self.tilt_cy_min, step))
                    moved = True
                elif walk_f < self.max_forward:
                    print('[bgas][倾斜] cy=%d < %d 且机身到上限，前进 %dmm' % (cy, self.tilt_cy_min, self.walk_mm), flush=True)
                    self._detail('倾斜闭环：cy=%d < %d 且机身到上限（目标仍远），前进 %dmm'
                                 % (cy, self.tilt_cy_min, self.walk_mm))
                    go_forward(self.ik, self.walk_mm, 50)
                    walk_f += 1
                    moved = True
                else:
                    print('[bgas][倾斜] cy=%d < %d 且抬身/前进都用尽，定位失败' % (cy, self.tilt_cy_min), flush=True)
                    self._detail('倾斜闭环失败：cy=%d < 窗口下限 %d，机身到上限且前进到上限（目标太高或太远）'
                                 % (cy, self.tilt_cy_min))
                    return None, '倾斜闭环：目标太高/太远（cy=%d < %d 且抬升/前进到上限）' % (cy, self.tilt_cy_min)
            elif cy > self.tilt_cy_max:
                # 偏下（近/低）：先降身，降到底再后退
                if self.body_z > self.body_min:
                    step = min(self.body_step, self.body_z - self.body_min)
                    self.set_body(self.body_z - step,
                                  reason='倾斜闭环：cy=%d > 窗口上限 %d（目标偏近/低），降低机身 %dmm'
                                         % (cy, self.tilt_cy_max, step))
                    moved = True
                elif walk_b < self.max_back:
                    print('[bgas][倾斜] cy=%d > %d 且机身到下限，后退 %dmm' % (cy, self.tilt_cy_max, self.walk_mm), flush=True)
                    self._detail('倾斜闭环：cy=%d > %d 且机身到下限（目标太近），后退 %dmm'
                                 % (cy, self.tilt_cy_max, self.walk_mm))
                    go_back(self.ik, self.walk_mm, 50)
                    walk_b += 1
                    moved = True
                else:
                    print('[bgas][倾斜] cy=%d > %d 且降身/后退都用尽，定位失败' % (cy, self.tilt_cy_max), flush=True)
                    self._detail('倾斜闭环失败：cy=%d > 窗口上限 %d，机身到下限且后退到上限（目标太近或平台太低）'
                                 % (cy, self.tilt_cy_max))
                    return None, '倾斜闭环：目标太近/太低（cy=%d > %d 且降身/后退到上限）' % (cy, self.tilt_cy_max)
            if moved:
                stable = 0
                time.sleep(0.4)
                continue
            stable += 1
            if stable >= 3:
                fx, fy = self.fixed_grab
                context = {
                    'strategy': 'fixed',
                    'detect': r,
                    'x': float(fx),
                    'y': float(fy),
                    'z': float(self.fixed_z),
                    'body_z': int(self.body_z),
                    'cy': int(cy),
                    'tilt_pose': list(self.tilt_pose),
                    'tilt_pitch': int(self.tilt_pitch),
                    'cx_min': int(self.tilt_cx_min),
                    'cx_max': int(self.tilt_cx_max),
                    'cy_min': int(self.tilt_cy_min),
                    'cy_max': int(self.tilt_cy_max),
                }
                print('[bgas][倾斜] 定位完成：cx=%d cy=%d 机身=%+dmm，固定夹取点 (%.1f, %.1f)'
                      % (cx, cy, self.body_z, fx, fy))
                self._detail('bgas 倾斜路线验收通过：cx=%d∈[%d,%d] cy=%d∈[%d,%d] 连续 %d 帧稳定，'
                             '固定夹取点 (%.1f,%.1f,%.1f)，移交 grab（只动 21-25）'
                             % (cx, self.tilt_cx_min, self.tilt_cx_max, cy, self.tilt_cy_min,
                                self.tilt_cy_max, stable, fx, fy, context['z']))
                self._status(2)
                return context, None
            time.sleep(0.2)
        return None, '倾斜闭环 %d 轮未收敛（最后 cx=%d cy=%d）' % (self.tilt_rounds, cx, cy)